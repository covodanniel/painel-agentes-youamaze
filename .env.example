# ==== Painel agentes youAmaze — variaveis do APP ====
# NENHUMA destas e segredo. Segredos (client_id/secret, cookie_secret) vivem
# no oauth2-proxy/Caddy, fora do repo. Copie para .env e ajuste se precisar.

# Porta da API / servidor (padrao 3000).
PORT=3000

# Host de bind. Padrao 127.0.0.1 (loopback): o painel NAO deve ser exposto
# direto na rede — o acesso publico passa pelo reverse proxy (Caddy+oauth2-proxy).
# Use 0.0.0.0 apenas conscientemente (ex.: dentro de container isolado).
HOST=127.0.0.1

# Ambiente. Use "production" no deploy.
NODE_ENV=production

# Confianca em proxy (Express). Padrao "loopback" (proxy no mesmo host).
# Pode receber IP/subnet do proxy se a topologia mudar.
TRUST_PROXY=loopback

# Defesa em profundidade: exige o header de identidade injetado pelo proxy.
# true em producao (atras do oauth2-proxy); false no dev local.
REQUIRE_PROXY_AUTH=false

# Nome do header de identidade injetado pelo proxy.
AUTH_HEADER=x-auth-request-email
