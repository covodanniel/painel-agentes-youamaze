# Env do APP (sample) — painel agentes youAmaze
# Copie para deploy/painel.env (gitignored) no host. NENHUM segredo aqui:
# os segredos do login ficam no oauth2-proxy, nao no app.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
TRUST_PROXY=loopback
REQUIRE_PROXY_AUTH=true
AUTH_HEADER=x-auth-request-email
