# systemd unit (sample) — oauth2-proxy (login Google) na frente do app.
# Instale em /etc/systemd/system/oauth2-proxy.service, ajuste caminhos e:
#   sudo systemctl daemon-reload && sudo systemctl enable --now oauth2-proxy
# Binario: https://github.com/oauth2-proxy/oauth2-proxy/releases

[Unit]
Description=oauth2-proxy (Google) para o painel youAmaze
After=network.target

[Service]
Type=simple
User=oauth2-proxy
Group=oauth2-proxy
ExecStart=/usr/local/bin/oauth2-proxy --config=/etc/oauth2-proxy/oauth2-proxy.cfg
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
